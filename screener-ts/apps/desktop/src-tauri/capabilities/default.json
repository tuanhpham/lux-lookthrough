{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities: HTTP to financial APIs + app-data file storage.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://query1.finance.yahoo.com/*" },
        { "url": "https://query2.finance.yahoo.com/*" },
        { "url": "https://finnhub.io/*" }
      ]
    },
    "fs:default",
    {
      "identifier": "fs:allow-app-meta-recursive",
      "allow": [{ "path": "$APPDATA/**" }]
    }
  ]
}
