{
  "name": "@screener/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:core && vite",
    "dev:desktop": "npm run dev",
    "build": "npm run build:core && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:core && tsc -p tsconfig.json --noEmit",
    "//build:core": "@screener/core resolves to its dist/, which is gitignored — so a fresh clone has none, and adding a core file leaves it stale. Both surface here as bogus 'has no exported member' errors. Building it first makes that impossible to hit.",
    "build:core": "npm --prefix ../../packages/core run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@screener/core": "*",
    "js-yaml": "^4.1.0",
    "lightweight-charts": "^4.1.3",
    "marked": "^12.0.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.0",
    "vite": "^8.0.16"
  }
}
