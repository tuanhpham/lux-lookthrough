# Desktop / web build configuration. Copy to .env and adjust.

# Which DataProvider to use: "yahoo" (default, free) or "finnhub" (fallback).
VITE_DATA_PROVIDER=yahoo

# DESKTOP ONLY: Finnhub key, read at runtime and sent via the Rust HTTP layer.
# NEVER set this for the web build — the web build hides the key behind the
# Cloudflare Pages function (set it there with `wrangler pages secret put`).
# VITE_FINNHUB_API_KEY=your_key_here
