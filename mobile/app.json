{
  "expo": {
    "name": "AMR",
    "slug": "amr",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0d0d",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amr.stockapp"
    },
    "android": {
      "package": "com.amr.stockapp"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
