{
  "name": "screener-ts",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript monorepo stock screener — platform-agnostic core + Tauri desktop app.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @screener/core",
    "test:core": "npm run test --workspace @screener/core",
    "dev:desktop": "npm run dev --workspace @screener/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
