# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=amr
POSTGRES_PASSWORD=amrpassword
POSTGRES_DB=amr_db
DATABASE_URL=postgresql+asyncpg://amr:amrpassword@db:5432/amr_db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Data providers ────────────────────────────────────────────────────────────
# Prototype: yfinance (no key needed)
# TODO: Replace with Finnhub for production
FINNHUB_API_KEY=your_finnhub_api_key_here
DATA_PROVIDER=yfinance   # options: yfinance | finnhub

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development       # development | production
SECRET_KEY=change_me_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Mobile (Expo) ─────────────────────────────────────────────────────────────
# Set in mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:8000
